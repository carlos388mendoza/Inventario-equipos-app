# ────────────────────────────────────────────────────────────────────────────
# Variables de entorno — Inventario de Equipos (Grupo Comidas)
# Copia este archivo a `.env.local` y completa los valores.
# NUNCA subas valores reales al repositorio. `.env*` está en `.gitignore`.
# ────────────────────────────────────────────────────────────────────────────

# Base de datos Turso (libSQL)
# Desarrollo local sin cuenta:  file:./data/local.db
# Producción (Turso):           libsql://<db>-<org>.turso.io
TURSO_DATABASE_URL=file:./data/local.db

# Token de acceso de Turso (solo para bases remotas). En desarrollo local se deja vacío.
# Obténlo con:  turso db tokens create <nombre-de-la-db>
TURSO_AUTH_TOKEN=

# Better Auth
# Secreto de firma de sesiones. Genera uno con:  npx @better-auth/cli secret
BETTER_AUTH_SECRET=

# URL base de la aplicación para Better Auth.
# Desarrollo:  http://localhost:3000
# Producción:  https://<tu-dominio>.vercel.app
BETTER_AUTH_URL=http://localhost:3000

# IA (AI SDK)
# Clave de la API del proveedor (OpenAI u otro compatible con la API de OpenAI).
AI_PROVIDER_API_KEY=

# Opcional: URL base del proveedor OpenAI-compatible (por defecto usa OpenAI).
AI_BASE_URL=

# Opcional: modelo a utilizar (por defecto "gpt-4o-mini").
AI_MODEL=gpt-4o-mini