# ────────────────────────────────────────────────────────────────────────────
# Variables de entorno — Inventario de Equipos (Grupo Comidas)
# Copia este archivo a `.env.local` y completa los valores.
# NUNCA subas valores reales al repositorio. `.env*` está en `.gitignore`.
# ────────────────────────────────────────────────────────────────────────────

# Base de datos Turso (libSQL)
# Desarrollo local sin cuenta:  file:./data/local.db
# Producción (Turso):           libsql://<db>-<org>.turso.io
TURSO_DATABASE_URL=file:./data/local.db

# Token de acceso de Turso (solo para bases remotas). En desarrollo local se deja vacío.
# Obténlo con:  turso db tokens create <nombre-de-la-db>
TURSO_AUTH_TOKEN=

# Better Auth
# Secreto de firma de sesiones. Genera uno con:  npx @better-auth/cli secret
BETTER_AUTH_SECRET=

# URL base de la aplicación para Better Auth.
# Desarrollo:  http://localhost:3000
# Producción:  https://<tu-dominio>.vercel.app
BETTER_AUTH_URL=http://localhost:3000

# URL pública de la aplicación. Se usa en dos sitios:
#  - la página pública del QR /e/[token] (lib/utils.ts → appBaseUrl)
#  - la URL canónica de metadata, robots.txt y sitemap.xml (lib/site.ts)
# Si se omite, el SEO usa como respaldo https://inventario-equipos-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# IA (AI SDK + OpenRouter)
# El proveedor real es OpenRouter (lib/ai/openrouter.ts). Sin esta clave la app
# sigue funcionando: las funciones de IA se deshabilitan con un mensaje claro.
OPENROUTER_API_KEY=

# Opcional: modelo de OpenRouter. Por defecto "openai/gpt-4o-mini".
AI_MODEL=openai/gpt-4o-mini

# Correo de notificaciones de solicitudes (issue #13)
# El envío real usa Resend por HTTP (lib/email/send.ts). Si esta clave está
# vacía la app NO falla: las notificaciones quedan registradas en la SBD
# `request_notifications` con estado SKIPPED y no sale ningún correo.
RESEND_API_KEY=

# Remitente del correo. Debe estar verificado en Resend:
# Ej. "Inventario de Equipos <no-reply@tu-dominio.com>"
MAIL_FROM=Inventario de Equipos <no-reply@inventario-equipos.local>

# Destinatarios de los avisos de aprobación (damaris del flujo). Separados por
# comas. Si se deja vacío, se avisa automáticamente a los usuarios ADMIN.
# Ej. REQUEST_APPROVER_EMAILS=damaris@grupo.com,gerencia@grupo.com
REQUEST_APPROVER_EMAILS=

# Secreto del cron de seguimiento (issue #13). Debe llamarse a
# GET /api/cron/request-followups con cabecera x-cron-secret igual a este valor
# (o Authorization: Bearer <valor>). Sin él, el cron responde 401.
CRON_SECRET=